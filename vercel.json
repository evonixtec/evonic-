{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "tools.evonixtec.com" }],
      "destination": "/sitemap-tools.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "store.evonixtec.com" }],
      "destination": "/sitemap-store.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/pos-software-in-sialkot",
      "destination": "/blog/pos-software-in-sialkot",
      "permanent": true
    },
    {
      "source": "/pos-software-sialkot",
      "destination": "/services/software-pos",
      "permanent": true
    },
    {
      "source": "/sialkot-it-services",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/locations/:city/hardware-maintenance",
      "destination": "https://store.evonixtec.com/hardware-repair",
      "permanent": true
    },
    {
      "source": "/locations/:city/laptop-repair",
      "destination": "https://store.evonixtec.com/laptop-repairing-sialkot",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "https://store.evonixtec.com/:path*",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/store/:path*",
      "destination": "https://store.evonixtec.com/:path*",
      "permanent": true
    },
    {
      "source": "/services/doorstep-support",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/services/doorstep-support/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/doorstep-support",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/doorstep-support/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/live-repair-tracker",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/live-repair-tracker/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/repair-tracker",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/repair-tracker/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/printer-diagnostics",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/printer-diagnostics/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/printer-troubleshooter",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/printer-troubleshooter/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/bench-intake-pass",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/bench-intake-pass/:path*",
      "destination": "https://store.evonixtec.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "evonixtec.com"
        }
      ],
      "destination": "https://www.evonixtec.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
