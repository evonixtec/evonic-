{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "tools.evonixtec.com" }],
      "destination": "/sitemap-tools.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "store.evonixtec.com" }],
      "destination": "/sitemap-store.xml"
    },
    {
      "source": "/tools",
      "destination": "/index.html"
    },
    {
      "source": "/tools/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tool",
      "destination": "/index.html"
    },
    {
      "source": "/tool/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/locations/sialkot/pos-hardware",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
